<Window x:Class="LuxMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LuxMonitor.ViewModels"
        xmlns:loc="clr-namespace:LuxMonitor.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Lux Monitor"
        Width="260" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="/Assets/LuxMonitor.ico"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Foreground="{DynamicResource TextBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- Pas de barre de titre Windows, mais une vraie fenêtre (compatible avec l'effet Acrylic).
         L'ancien mode AllowsTransparency était incompatible avec les effets de Windows 11. -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid>
    <StackPanel Margin="14,12,14,4">

        <!-- En-tête -->
        <Grid Margin="4,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Petite décoration du thème avant le titre (facultative) -->
                <Image Style="{StaticResource OrnamentImage}" Source="{DynamicResource HeaderOrnament}"
                       Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Lux" FontSize="16" FontWeight="SemiBold"
                           FontFamily="{DynamicResource HeaderFontFamily}"/>
                <TextBlock Text=" Monitor" FontSize="16" FontWeight="Light"
                           FontFamily="{DynamicResource HeaderFontFamily}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Visibility="{Binding IsNormalLayout, Converter={StaticResource BoolToVisibility}}"/>
                <Border Margin="10,0,0,0" Padding="7,1" CornerRadius="8" VerticalAlignment="Center"
                        Background="{DynamicResource BadgeBrush}"
                        Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:Tr Widget.Demo}" FontSize="10" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <!-- Icônes : police Segoe Fluent Icons, intégrée à Windows 11 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Click="OverlayButton_Click" ToolTip="{loc:Tr Tip.GameMode}"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE7FC;" Margin="0,0,6,0"/>
                <Button Style="{StaticResource IconButton}" Click="ThemeButton_Click" ToolTip="{loc:Tr Tip.Theme}"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE790;" Margin="0,0,6,0"/>
                <Button Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="{loc:Tr Tip.Hide}"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Content="&#xE8BB;"/>
            </StackPanel>
        </Grid>

        <!-- ===== Disposition NORMALE ===== -->
        <Border Style="{StaticResource RevealPanel}"
                Visibility="{Binding IsNormalLayout, Converter={StaticResource BoolToVisibility}}">
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>

            <StackPanel>
                <!-- FPS : visible seulement quand une application affiche des images (et en mode admin) -->
                <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="{DynamicResource TileCornerRadius}" BorderThickness="1"
                        Background="{DynamicResource TileBackgroundBrush}"
                        BorderBrush="{DynamicResource TileBorderBrush}"
                        Visibility="{Binding HasFps, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileLabel}">
                            <Run Text="FPS  ·  "/>
                            <Run Text="{Binding FpsProcessName, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding FpsText}" Style="{StaticResource TileValue}"/>
                    </StackPanel>
                </Border>

                <!-- Processeur -->
                <Button Style="{StaticResource TileButton}" Click="Cpu_Click"
                        ToolTip="{loc:Tr Tip.Cpu}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Style="{StaticResource TileIcon}" Data="{StaticResource IconCpu}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource TileLabel}">
                                <Run Text="{loc:Tr Widget.Processor}"/><Run Text="  ·  "/>
                                <Run Text="{Binding CpuName, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding CpuText}" Style="{StaticResource TileValue}"/>
                            <ProgressBar Style="{StaticResource Gauge}" Value="{Binding CpuPercent, Mode=OneWay}"/>
                            <TextBlock Text="{Binding CpuTemperatureText}" Style="{StaticResource TileDetail}"
                                       Visibility="{Binding HasCpuTemperature, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Cartes graphiques -->
                <ItemsControl ItemsSource="{Binding Gpus}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GpuViewModel}">
                            <Button Style="{StaticResource TileButton}" Click="Gpu_Click"
                                    ToolTip="{loc:Tr Tip.Gpu}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource TileIcon}" Data="{StaticResource IconGpu}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource TileLabel}">
                                            <Run Text="{loc:Tr Widget.Gpu}"/><Run Text="  ·  "/>
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding LoadText}" Style="{StaticResource TileValue}"/>
                                        <ProgressBar Style="{StaticResource Gauge}" Value="{Binding LoadPercent, Mode=OneWay}"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource TileDetail}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- RAM -->
                <Button Style="{StaticResource TileButton}" Click="Ram_Click"
                        ToolTip="{loc:Tr Tip.Ram}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Style="{StaticResource TileIcon}" Data="{StaticResource IconRam}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="RAM" Style="{StaticResource TileLabel}"/>
                            <TextBlock Text="{Binding RamText}" Style="{StaticResource TileValue}"/>
                            <ProgressBar Style="{StaticResource Gauge}" Value="{Binding RamPercent, Mode=OneWay}"/>
                            <!-- Barrettes installées (fabricant + capacité), si Windows les connaît -->
                            <TextBlock Text="{Binding RamModulesText}" Style="{StaticResource TileDetail}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasRamModules, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Disques -->
                <TextBlock Text="{loc:Tr Widget.Disks}" Style="{StaticResource SectionTitle}"/>

                <ItemsControl ItemsSource="{Binding Disks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DiskViewModel}">
                            <Button Style="{StaticResource TileButton}" Click="Disk_Click"
                                    ToolTip="{loc:Tr Tip.Disk}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource TileIcon}" Data="{StaticResource IconDisk}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource TileLabel}">
                                            <Run Text="{Binding Title, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding Label, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding UsedPercent, StringFormat={}{0:0} %}"
                                                   Style="{StaticResource TileValue}"/>
                                        <ProgressBar Style="{StaticResource Gauge}" Value="{Binding UsedPercent, Mode=OneWay}"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource TileDetail}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ===== Disposition MINIATURE : une ligne par élément ===== -->
        <Border Style="{StaticResource RevealPanel}"
                Visibility="{Binding IsCompact, Converter={StaticResource BoolToVisibility}}">
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>

            <StackPanel>
                <!-- FPS -->
                <Border Margin="0,0,0,6" Padding="12,7" CornerRadius="{DynamicResource TileCornerRadius}" BorderThickness="1"
                        Background="{DynamicResource TileBackgroundBrush}"
                        BorderBrush="{DynamicResource TileBorderBrush}"
                        ToolTip="{Binding FpsProcessName}"
                        Visibility="{Binding HasFps, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <TextBlock Text="FPS" Style="{StaticResource CompactLabel}"/>
                        <TextBlock Text="{Binding FpsText}" Style="{StaticResource CompactValue}"/>
                    </Grid>
                </Border>

                <!-- Processeur -->
                <Button Style="{StaticResource CompactTileButton}" Click="Cpu_Click"
                        ToolTip="{Binding CpuName}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CPU" Style="{StaticResource CompactLabel}"/>
                            <TextBlock Style="{StaticResource CompactValue}">
                                <Run Text="{Binding CpuTemperatureText, Mode=OneWay}"
                                     Foreground="{DynamicResource MutedTextBrush}"/>
                                <Run Text="{Binding CpuText, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                        <ProgressBar Style="{StaticResource GaugeThin}" Value="{Binding CpuPercent, Mode=OneWay}"/>
                    </StackPanel>
                </Button>

                <!-- Cartes graphiques -->
                <ItemsControl ItemsSource="{Binding Gpus}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GpuViewModel}">
                            <Button Style="{StaticResource CompactTileButton}" Click="Gpu_Click"
                                    ToolTip="{Binding Name}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="GPU" Style="{StaticResource CompactLabel}"/>
                                        <TextBlock Style="{StaticResource CompactValue}">
                                            <Run Text="{Binding TemperatureText, Mode=OneWay}"
                                                 Foreground="{DynamicResource MutedTextBrush}"/>
                                            <Run Text="{Binding LoadText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                    <ProgressBar Style="{StaticResource GaugeThin}" Value="{Binding LoadPercent, Mode=OneWay}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- RAM -->
                <Button Style="{StaticResource CompactTileButton}" Click="Ram_Click"
                        ToolTip="{Binding RamText}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="RAM" Style="{StaticResource CompactLabel}"/>
                            <TextBlock Text="{Binding RamPercent, StringFormat={}{0:0} %}" Style="{StaticResource CompactValue}"/>
                        </Grid>
                        <ProgressBar Style="{StaticResource GaugeThin}" Value="{Binding RamPercent, Mode=OneWay}"/>
                    </StackPanel>
                </Button>

                <!-- Disques -->
                <ItemsControl ItemsSource="{Binding Disks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DiskViewModel}">
                            <Button Style="{StaticResource CompactTileButton}" Click="Disk_Click"
                                    ToolTip="{Binding Detail}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CompactLabel}"/>
                                        <TextBlock Text="{Binding UsedPercent, StringFormat={}{0:0} %}"
                                                   Style="{StaticResource CompactValue}"/>
                                    </Grid>
                                    <ProgressBar Style="{StaticResource GaugeThin}" Value="{Binding UsedPercent, Mode=OneWay}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ===== Disposition BANDEAU : tout sur une ligne, cases de même largeur ===== -->
        <Border Style="{StaticResource RevealPanel}"
                Visibility="{Binding IsStrip, Converter={StaticResource BoolToVisibility}}">
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>

            <ItemsControl ItemsSource="{Binding StripItems}" Margin="-3,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Une seule ligne : chaque case reçoit la même part de la largeur -->
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StripItemViewModel}">
                        <Button Style="{StaticResource CompactTileButton}" Margin="3,0,3,6"
                                Click="StripItem_Click" IsEnabled="{Binding IsClickable}"
                                ToolTip="{Binding ToolTip}" ToolTipService.ShowOnDisabled="True">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource CompactLabel}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Style="{StaticResource CompactValue}" HorizontalAlignment="Left"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Value, Mode=OneWay}"/>
                                    <Run Text="{Binding Secondary, Mode=OneWay}"
                                         Foreground="{DynamicResource MutedTextBrush}"/>
                                </TextBlock>
                                <ProgressBar Style="{StaticResource GaugeThin}" Value="{Binding Percent, Mode=OneWay}"
                                             Visibility="{Binding HasGauge, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>

    <!-- Décoration de coin du thème (facultative, discrète, ne capte pas la souris) -->
    <Image Style="{StaticResource OrnamentImage}" Source="{DynamicResource CornerOrnament}"
           HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="34" Margin="8,0,0,6"/>

    <!-- Poignée de redimensionnement (largeur) : la disposition s'adapte toute seule
         (étroit = miniature, moyen = normal, large = bandeau). -->
    <Thumb x:Name="ResizeGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
           Width="16" Height="16" Cursor="SizeWE" ToolTip="{loc:Tr Tip.Resize}"
           DragDelta="ResizeGrip_DragDelta" DragCompleted="ResizeGrip_DragCompleted">
        <Thumb.Template>
            <ControlTemplate TargetType="Thumb">
                <Border Background="Transparent">
                    <Path Data="M 12,4 L 4,12 M 12,8 L 8,12" Stroke="{DynamicResource MutedTextBrush}"
                          StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Border>
            </ControlTemplate>
        </Thumb.Template>
    </Thumb>
    </Grid>
</Window>
