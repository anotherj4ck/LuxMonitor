<Window x:Class="LuxMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LuxMonitor.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Lux Monitor"
        Width="320" SizeToContent="Height"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Foreground="{DynamicResource TextBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- Pas de barre de titre Windows, mais une vraie fenêtre (compatible avec l'effet Acrylic).
         L'ancien mode AllowsTransparency était incompatible avec les effets de Windows 11. -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <StackPanel Margin="14,12,14,4">

        <!-- En-tête -->
        <Grid Margin="4,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Lux" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text=" Monitor" FontSize="16" FontWeight="Light"
                           Foreground="{DynamicResource MutedTextBrush}"/>
                <Border Margin="10,0,0,0" Padding="7,1" CornerRadius="8" VerticalAlignment="Center"
                        Background="{DynamicResource BadgeBrush}"
                        Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="DÉMO" FontSize="10" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <!-- Icônes : police Segoe Fluent Icons, intégrée à Windows 11 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Click="ThemeButton_Click" ToolTip="Changer de thème"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE790;" Margin="0,0,6,0"/>
                <Button Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="Fermer"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Content="&#xE8BB;"/>
            </StackPanel>
        </Grid>

        <!-- Panneau des thèmes (caché par défaut) -->
        <Border Style="{StaticResource RevealPanel}" Margin="0,0,0,10" Padding="8,10,8,6" CornerRadius="18"
                Background="{DynamicResource TileBackgroundBrush}"
                BorderBrush="{DynamicResource TileBorderBrush}" BorderThickness="1"
                Visibility="{Binding IsThemePanelOpen, Converter={StaticResource BoolToVisibility}}">
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>

            <StackPanel>
                <TextBlock Text="THÈME" Style="{StaticResource SectionTitle}" Margin="8,0,0,6"/>

                <ItemsControl ItemsSource="{Binding ThemeOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ThemeOptionViewModel}">
                            <Button Style="{StaticResource ThemeOptionButton}" Click="ThemeOption_Click"
                                    ToolTip="{Binding Name}">
                                <StackPanel>
                                    <!-- Aperçu : fond du thème + petite jauge à sa couleur d'accent -->
                                    <Grid Width="58" Height="40">
                                        <Border CornerRadius="12" BorderThickness="1"
                                                Background="{Binding PreviewBackground}"
                                                BorderBrush="{DynamicResource TileBorderBrush}"/>
                                        <Border Width="26" Height="4" CornerRadius="2" VerticalAlignment="Bottom"
                                                Margin="0,0,0,9" Background="{Binding PreviewAccent}"/>
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                   Margin="0,5,7,0" Foreground="{Binding PreviewAccent}"
                                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="12" Margin="0,6,0,0"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Processeur -->
        <Button Style="{StaticResource TileButton}" Click="Cpu_Click"
                ToolTip="Ouvrir le Gestionnaire des tâches">
            <StackPanel>
                <TextBlock Text="Processeur" Style="{StaticResource TileLabel}"/>
                <TextBlock Text="{Binding CpuText}" Style="{StaticResource TileValue}"/>
                <ProgressBar Style="{StaticResource Gauge}" Value="{Binding CpuPercent, Mode=OneWay}"/>
            </StackPanel>
        </Button>

        <!-- Cartes graphiques -->
        <ItemsControl ItemsSource="{Binding Gpus}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GpuViewModel}">
                    <Button Style="{StaticResource TileButton}" Click="Gpu_Click"
                            ToolTip="Ouvrir le logiciel de la carte graphique">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabel}">
                                <Run Text="Carte graphique  ·  "/>
                                <Run Text="{Binding Name, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding LoadText}" Style="{StaticResource TileValue}"/>
                            <ProgressBar Style="{StaticResource Gauge}" Value="{Binding LoadPercent, Mode=OneWay}"/>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource TileDetail}"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Mémoire -->
        <Button Style="{StaticResource TileButton}" Click="Ram_Click"
                ToolTip="Ouvrir le Gestionnaire des tâches">
            <StackPanel>
                <TextBlock Text="Mémoire" Style="{StaticResource TileLabel}"/>
                <TextBlock Text="{Binding RamText}" Style="{StaticResource TileValue}"/>
                <ProgressBar Style="{StaticResource Gauge}" Value="{Binding RamPercent, Mode=OneWay}"/>
            </StackPanel>
        </Button>

        <!-- Disques -->
        <TextBlock Text="DISQUES" Style="{StaticResource SectionTitle}"/>

        <ItemsControl ItemsSource="{Binding Disks}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DiskViewModel}">
                    <Button Style="{StaticResource TileButton}" Click="Disk_Click"
                            ToolTip="Ouvrir dans l'Explorateur de fichiers">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabel}">
                                <Run Text="{Binding Title, Mode=OneWay}"/>
                                <Run Text="  ·  "/>
                                <Run Text="{Binding Label, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding UsedPercent, StringFormat={}{0:0} %}"
                                       Style="{StaticResource TileValue}"/>
                            <ProgressBar Style="{StaticResource Gauge}" Value="{Binding UsedPercent, Mode=OneWay}"/>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource TileDetail}"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Window>
