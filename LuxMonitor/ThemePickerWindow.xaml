<!--
    Choix du thème : petite fenêtre qui s'ouvre JUSTE À CÔTÉ du widget, du côté où il y a de la place
    (à droite si le widget est à gauche de l'écran, à gauche sinon). Le widget garde ainsi sa taille.
    Elle se ferme toute seule dès qu'on clique ailleurs.
-->
<Window x:Class="LuxMonitor.ThemePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LuxMonitor.ViewModels"
        xmlns:loc="clr-namespace:LuxMonitor.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{loc:Tr Widget.Theme}"
        Width="292" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
        Icon="/Assets/LuxMonitor.ico"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Foreground="{DynamicResource TextBrush}"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <StackPanel Margin="12,10,12,8">
        <!-- En-tête : titre + fermer -->
        <Grid Margin="6,0,0,8">
            <TextBlock Text="{loc:Tr Widget.Theme}" Style="{StaticResource SectionTitle}"
                       Margin="0" VerticalAlignment="Center"/>
            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="Close_Click"
                    ToolTip="{loc:Tr Tip.Close}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    FontSize="10" Content="&#xE8BB;"/>
        </Grid>

        <ItemsControl ItemsSource="{Binding ThemeOptions}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- WrapPanel à largeur fixe (ItemWidth) : toutes les pastilles occupent la même place,
                         quelle que soit la longueur du nom. Elles forment une grille régulière qui
                         restent alignées quelle que soit la langue. -->
                    <WrapPanel HorizontalAlignment="Center" ItemWidth="84"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ThemeOptionViewModel}">
                    <Button Style="{StaticResource ThemeOptionButton}" Click="ThemeOption_Click"
                            ToolTip="{Binding Name}">
                        <StackPanel>
                            <!-- Aperçu : fond du thème + petite jauge à sa couleur d'accent -->
                            <Grid Width="58" Height="40">
                                <Border CornerRadius="12" BorderThickness="1"
                                        Background="{Binding PreviewBackground}"
                                        BorderBrush="{DynamicResource TileBorderBrush}"/>
                                <Border Width="26" Height="4" CornerRadius="2" VerticalAlignment="Bottom"
                                        Margin="0,0,0,9" Background="{Binding PreviewAccent}"/>
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Margin="0,5,7,0" Foreground="{Binding PreviewAccent}"
                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                            <!-- Nom sur deux lignes au plus, centré ; hauteur fixe pour garder les rangées alignées -->
                            <TextBlock Text="{Binding Name}" FontSize="12" Margin="0,6,0,0"
                                       Width="76" Height="32" TextWrapping="Wrap" TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Window>
