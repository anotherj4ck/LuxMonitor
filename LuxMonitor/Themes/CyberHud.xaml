<!--
    Thème « Cyber HUD » : futuriste, néon cyan sur verre sombre.
    Mêmes clés (x:Key) que tous les autres thèmes. Décorations : volontairement discrètes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Texte -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFE6FBFF"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF6FC3D6"/>

    <!-- Tuiles -->
    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#1A00E5FF"/>
    <SolidColorBrush x:Key="TileHoverBrush" Color="#2E00E5FF"/>
    <SolidColorBrush x:Key="TilePressedBrush" Color="#4000E5FF"/>
    <LinearGradientBrush x:Key="TileBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9900E5FF" Offset="0"/>
        <GradientStop Color="#1F00E5FF" Offset="0.5"/>
        <GradientStop Color="#6600E5FF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#FF00E5FF"/>

    <!-- Jauges -->
    <SolidColorBrush x:Key="GaugeTrackBrush" Color="#2600E5FF"/>
    <LinearGradientBrush x:Key="GaugeFillBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF0087A8" Offset="0"/>
        <GradientStop Color="#FF35F0FF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Badge DÉMO -->
    <SolidColorBrush x:Key="BadgeBrush" Color="#4000E5FF"/>

    <!-- Fond de la fenêtre, et fond de secours si l'effet Acrylic n'est pas disponible -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#33000E16"/>
    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#F2050E14"/>

    <!-- Icônes des tuiles -->
    <SolidColorBrush x:Key="IconBrush" Color="#FF2EE6FF"/>

    <!-- Formes -->
    <CornerRadius x:Key="TileCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="GaugeCornerRadius">1</CornerRadius>

    <!-- Police du titre -->
    <FontFamily x:Key="HeaderFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Hexagone néon avant le titre -->
    <DrawingImage x:Key="HeaderOrnament">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
                <GeometryDrawing Geometry="M12,2 L20.66,7 V17 L12,22 L3.34,17 V7 Z"><GeometryDrawing.Pen><Pen Brush="#FF2EE6FF" Thickness="1.4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing>
                <GeometryDrawing Geometry="M12,7.5 L15.9,9.75 V14.25 L12,16.5 L8.1,14.25 V9.75 Z"><GeometryDrawing.Pen><Pen Brush="#992EE6FF" Thickness="1.1" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
