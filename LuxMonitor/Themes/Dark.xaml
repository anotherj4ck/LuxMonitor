<!--
    Thème « Sombre » : panneau opaque bleu nuit, lisible sur n'importe quel fond d'écran.
    Mêmes clés que Liquid.xaml, seules les valeurs changent.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Texte -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFF2F5FA"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF8C9AB3"/>

    <!-- Tuiles -->
    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#FF1A2234"/>
    <SolidColorBrush x:Key="TileHoverBrush" Color="#FF222C42"/>
    <SolidColorBrush x:Key="TilePressedBrush" Color="#FF2A3652"/>
    <LinearGradientBrush x:Key="TileBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF34405A" Offset="0"/>
        <GradientStop Color="#FF222B3E" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#FF6EA8FE"/>

    <!-- Jauges : dégradé bleu -->
    <SolidColorBrush x:Key="GaugeTrackBrush" Color="#FF26304A"/>
    <LinearGradientBrush x:Key="GaugeFillBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF3F6FD1" Offset="0"/>
        <GradientStop Color="#FF6EA8FE" Offset="1"/>
    </LinearGradientBrush>

    <!-- Badge DÉMO -->
    <SolidColorBrush x:Key="BadgeBrush" Color="#663F6FD1"/>

    <!-- Fond de la fenêtre : dégradé bleu nuit, opaque -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF141B2B" Offset="0"/>
        <GradientStop Color="#FF0E1320" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#FF111726"/>
</ResourceDictionary>
