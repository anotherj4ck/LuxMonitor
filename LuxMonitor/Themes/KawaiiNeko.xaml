<!--
    Thème « Kawaii Neko » : rose poudré, doux et mignon, avec une patte et un petit chat endormi.
    Mêmes clés (x:Key) que tous les autres thèmes. Décorations : volontairement discrètes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Texte -->
    <SolidColorBrush x:Key="TextBrush" Color="#FF6B3A4E"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FFAA7A8E"/>

    <!-- Tuiles -->
    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#B3FFF7FA"/>
    <SolidColorBrush x:Key="TileHoverBrush" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="TilePressedBrush" Color="#FFFFFFFF"/>
    <LinearGradientBrush x:Key="TileBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#40F2AFC4" Offset="0.5"/>
        <GradientStop Color="#80F2AFC4" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#FFF48FB1"/>

    <!-- Jauges -->
    <SolidColorBrush x:Key="GaugeTrackBrush" Color="#33E88AA6"/>
    <LinearGradientBrush x:Key="GaugeFillBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFF7B3C8" Offset="0"/>
        <GradientStop Color="#FFEE7A9E" Offset="1"/>
    </LinearGradientBrush>

    <!-- Badge DÉMO -->
    <SolidColorBrush x:Key="BadgeBrush" Color="#40F48FB1"/>

    <!-- Fond de la fenêtre, et fond de secours si l'effet Acrylic n'est pas disponible -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFDE6EE" Offset="0"/>
        <GradientStop Color="#FFF8D2E0" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#FFFBDDE6"/>

    <!-- Icônes des tuiles -->
    <SolidColorBrush x:Key="IconBrush" Color="#FFE88AA8"/>

    <!-- Formes -->
    <CornerRadius x:Key="TileCornerRadius">22</CornerRadius>
    <CornerRadius x:Key="GaugeCornerRadius">3</CornerRadius>

    <!-- Police du titre -->
    <FontFamily x:Key="HeaderFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Patte de chat avant le titre -->
    <DrawingImage x:Key="HeaderOrnament">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
                <GeometryDrawing Brush="#FFE88AA8"><GeometryDrawing.Geometry><GeometryGroup><EllipseGeometry Center="12,15.5" RadiusX="5" RadiusY="4"/><EllipseGeometry Center="6.5,9.5" RadiusX="1.9" RadiusY="2.3"/><EllipseGeometry Center="10,6.5" RadiusX="1.9" RadiusY="2.3"/><EllipseGeometry Center="14,6.5" RadiusX="1.9" RadiusY="2.3"/><EllipseGeometry Center="17.5,9.5" RadiusX="1.9" RadiusY="2.3"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <!-- Petit chat endormi, dessin original (coin bas-gauche) -->
    <DrawingImage x:Key="CornerOrnament">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
                <GeometryDrawing Brush="#CCFFFFFF" Geometry="M3,21 C3,14 6,12.5 8,12.5 L9,8.5 L11.5,12 H14.5 L17,8.5 L18,12.5 C20,12.5 23,14 23,21 Z"/>
                <GeometryDrawing Geometry="M3,21 C3,14 6,12.5 8,12.5 L9,8.5 L11.5,12 H14.5 L17,8.5 L18,12.5 C20,12.5 23,14 23,21 Z"><GeometryDrawing.Pen><Pen Brush="#99E88AA6" Thickness="1.1" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing>
                <GeometryDrawing Geometry="M9,16 Q10.25,17.2 11.5,16 M14.5,16 Q15.75,17.2 17,16"><GeometryDrawing.Pen><Pen Brush="#CCE88AA6" Thickness="1.1" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
