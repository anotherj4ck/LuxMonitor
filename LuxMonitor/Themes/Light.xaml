<!--
    Thème « Clair » : verre clair (Acrylic en teinte claire), texte foncé, accent jaune.
    Mêmes clés que Liquid.xaml, seules les valeurs changent.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Texte -->
    <SolidColorBrush x:Key="TextBrush" Color="#FF2B2620"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF7A6F60"/>

    <!-- Tuiles : blanc laiteux -->
    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="TileHoverBrush" Color="#A6FFFFFF"/>
    <SolidColorBrush x:Key="TilePressedBrush" Color="#CCFFFFFF"/>
    <LinearGradientBrush x:Key="TileBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6FFFFFF" Offset="0"/>
        <GradientStop Color="#33C9A227" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#FFE0B43A"/>

    <!-- Jauges : dégradé jaune -->
    <SolidColorBrush x:Key="GaugeTrackBrush" Color="#1A2B2620"/>
    <LinearGradientBrush x:Key="GaugeFillBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFF0CB6A" Offset="0"/>
        <GradientStop Color="#FFE0B43A" Offset="1"/>
    </LinearGradientBrush>

    <!-- Badge DÉMO -->
    <SolidColorBrush x:Key="BadgeBrush" Color="#40E0B43A"/>

    <!-- Fond de la fenêtre : léger voile blanc par-dessus l'Acrylic clair -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#FFF7F3EA"/>
</ResourceDictionary>
