<!--
    Thème « Lune Rouge (nom provisoire) » : noir profond et rouge sang, avec une couronne et une lune.
    Mêmes clés (x:Key) que tous les autres thèmes. Décorations : volontairement discrètes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Texte -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFF2E6E6"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF9C7B7B"/>

    <!-- Tuiles -->
    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#FF1A1012"/>
    <SolidColorBrush x:Key="TileHoverBrush" Color="#FF241519"/>
    <SolidColorBrush x:Key="TilePressedBrush" Color="#FF2E1A20"/>
    <LinearGradientBrush x:Key="TileBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#99C0182B" Offset="0"/>
        <GradientStop Color="#22C0182B" Offset="0.5"/>
        <GradientStop Color="#66C0182B" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#FFE0283C"/>

    <!-- Jauges -->
    <SolidColorBrush x:Key="GaugeTrackBrush" Color="#FF2A1518"/>
    <LinearGradientBrush x:Key="GaugeFillBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF8A0F1C" Offset="0"/>
        <GradientStop Color="#FFE0283C" Offset="1"/>
    </LinearGradientBrush>

    <!-- Badge DÉMO -->
    <SolidColorBrush x:Key="BadgeBrush" Color="#66C0182B"/>

    <!-- Fond de la fenêtre, et fond de secours si l'effet Acrylic n'est pas disponible -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF0F0A0B" Offset="0"/>
        <GradientStop Color="#FF160B0E" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#FF0F0A0B"/>

    <!-- Icônes des tuiles -->
    <SolidColorBrush x:Key="IconBrush" Color="#FFD6303F"/>

    <!-- Formes -->
    <CornerRadius x:Key="TileCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="GaugeCornerRadius">2</CornerRadius>

    <!-- Police du titre -->
    <FontFamily x:Key="HeaderFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Couronne avant le titre -->
    <DrawingImage x:Key="HeaderOrnament">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
                <GeometryDrawing Geometry="M3.5,17 L5,7.5 L9.5,12 L12,5 L14.5,12 L19,7.5 L20.5,17 Z M4,20 H20"><GeometryDrawing.Pen><Pen Brush="#FFD6303F" Thickness="1.4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <!-- Lune rouge discrète (coin bas-gauche) -->
    <DrawingImage x:Key="CornerOrnament">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
                <GeometryDrawing Brush="#55C0182B" Geometry="M14,3 A9,9 0 1 0 21.5,15.5 A7.5,7.5 0 1 1 14,3 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
