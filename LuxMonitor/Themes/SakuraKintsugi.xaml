<!--
    Thème « Sakura Kintsugi » : élégance japonaise, bordeaux profond, or et fleur de cerisier.
    Mêmes clés (x:Key) que tous les autres thèmes. Décorations : volontairement discrètes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Texte -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFF7EAD9"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FFC4A27E"/>

    <!-- Tuiles -->
    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#FF2A1418"/>
    <SolidColorBrush x:Key="TileHoverBrush" Color="#FF34191E"/>
    <SolidColorBrush x:Key="TilePressedBrush" Color="#FF3E1F25"/>
    <LinearGradientBrush x:Key="TileBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#CCE2B66A" Offset="0"/>
        <GradientStop Color="#33E2B66A" Offset="0.5"/>
        <GradientStop Color="#99E2B66A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#FFE2B66A"/>

    <!-- Jauges -->
    <SolidColorBrush x:Key="GaugeTrackBrush" Color="#FF3A2026"/>
    <LinearGradientBrush x:Key="GaugeFillBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFE04A64" Offset="0"/>
        <GradientStop Color="#FFFF8A80" Offset="1"/>
    </LinearGradientBrush>

    <!-- Badge DÉMO -->
    <SolidColorBrush x:Key="BadgeBrush" Color="#55E2B66A"/>

    <!-- Fond de la fenêtre, et fond de secours si l'effet Acrylic n'est pas disponible -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1C0C10" Offset="0"/>
        <GradientStop Color="#FF2A1216" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#FF1C0C10"/>

    <!-- Icônes des tuiles -->
    <SolidColorBrush x:Key="IconBrush" Color="#FFE8A05A"/>

    <!-- Formes -->
    <CornerRadius x:Key="TileCornerRadius">18</CornerRadius>
    <CornerRadius x:Key="GaugeCornerRadius">2</CornerRadius>

    <!-- Police du titre -->
    <FontFamily x:Key="HeaderFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Fleur de cerisier avant le titre -->
    <DrawingImage x:Key="HeaderOrnament">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
                <GeometryDrawing Brush="#FFF2A0B4"><GeometryDrawing.Geometry><GeometryGroup><EllipseGeometry Center="12.0,7.0" RadiusX="3.4" RadiusY="3.4"/><EllipseGeometry Center="16.76,10.45" RadiusX="3.4" RadiusY="3.4"/><EllipseGeometry Center="14.94,16.05" RadiusX="3.4" RadiusY="3.4"/><EllipseGeometry Center="9.06,16.05" RadiusX="3.4" RadiusY="3.4"/><EllipseGeometry Center="7.24,10.45" RadiusX="3.4" RadiusY="3.4"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FFE2B66A"><GeometryDrawing.Geometry><GeometryGroup><EllipseGeometry Center="12,12" RadiusX="1.8" RadiusY="1.8"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <!-- Vagues dorées (coin bas-gauche) -->
    <DrawingImage x:Key="CornerOrnament">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
                <GeometryDrawing Geometry="M2,21 A5,5 0 0 1 12,21 A5,5 0 0 1 22,21 M5,21 A2,2 0 0 1 9,21 M15,21 A2,2 0 0 1 19,21"><GeometryDrawing.Pen><Pen Brush="#80E2B66A" Thickness="1.1" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
