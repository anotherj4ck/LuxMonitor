<!--
    Fenêtre d'accueil : affichée au premier lancement, puis accessible depuis le menu de l'icône
    ("Température et FPS…"). Elle explique ce qu'il faut pour la température du processeur et les FPS,
    et propose de l'activer. Rien n'est jamais installé ou activé sans un clic de l'utilisateur.
-->
<Window x:Class="LuxMonitor.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bienvenue dans Lux Monitor"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Icon="/Assets/LuxMonitor.ico"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Foreground="{DynamicResource TextBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <StackPanel Margin="24,20,24,22">

        <!-- En-tête -->
        <Grid Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Bienvenue dans " FontSize="20" FontWeight="Light"/>
                <TextBlock Text="Lux" FontSize="20" FontWeight="SemiBold"/>
            </StackPanel>
            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="Close_Click"
                    ToolTip="Fermer" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                    Content="&#xE8BB;"/>
        </Grid>

        <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,0,0,16"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="Lux Monitor fonctionne déjà : processeur, carte graphique, RAM et disques s'affichent sans rien installer. Deux informations demandent un peu plus de préparation."/>

        <!-- Carte : température et FPS -->
        <Border Padding="18,16" CornerRadius="18" BorderThickness="1"
                Background="{DynamicResource TileBackgroundBrush}"
                BorderBrush="{DynamicResource TileBorderBrush}">
            <StackPanel>
                <TextBlock Text="Température du processeur et FPS" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,6,0,14"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Windows ne donne pas ces informations directement. Pour les lire, Lux Monitor a besoin de deux choses :"/>

                <!-- Étape 1 : PawnIO -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock FontSize="13" FontWeight="SemiBold">
                            <Run Text="1.  Le pilote PawnIO"/>
                            <Run x:Name="PawnIoStatus" FontWeight="Normal"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Gratuit et open source, utilisé aussi par LibreHardwareMonitor et Fan Control. Nécessaire pour la température."/>
                    </StackPanel>
                    <Button x:Name="PawnIoButton" Grid.Column="1" Style="{StaticResource ActionButton}"
                            VerticalAlignment="Center" Content="Télécharger" Click="PawnIo_Click"
                            ToolTip="Ouvre le site officiel de PawnIO dans le navigateur"/>
                </Grid>

                <!-- Étape 2 : démarrage administrateur -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock FontSize="13" FontWeight="SemiBold">
                            <Run Text="2.  Les droits administrateur"/>
                            <Run x:Name="AdminStatus" FontWeight="Normal"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Nécessaires pour la température et les FPS. Lux Monitor crée une tâche planifiée qui le lance ainsi à chaque ouverture de session, sans vous le redemander."/>
                    </StackPanel>
                    <Button x:Name="AdminButton" Grid.Column="1" Style="{StaticResource ActionButton}"
                            VerticalAlignment="Center" Content="Activer" Click="Admin_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Message de résultat (ex. : écran administrateur refusé) -->
        <TextBlock x:Name="ResultMessage" TextWrapping="Wrap" FontSize="12" Margin="4,10,4,0"
                   Visibility="Collapsed"/>

        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="4,14,4,16"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="Un pilote a un accès très profond au système : ne l'installez que si vous faites confiance à sa source. Vous pourrez revenir ici à tout moment depuis le menu de l'icône Lux Monitor (« Température et FPS… »)."/>

        <Button Style="{StaticResource ActionButton}" HorizontalAlignment="Right" Content="Terminer"
                Click="Close_Click"/>
    </StackPanel>
</Window>
